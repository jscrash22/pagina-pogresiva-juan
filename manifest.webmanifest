{
  "name": "Burger Juan",
  "short_name": "Burger Juan",
  "description": "Restaurante de comida rápida progresivo con menú, carrito, modo sin conexión y formularios persistentes.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#17150f",
  "theme_color": "#e4002b",
  "categories": ["food", "shopping", "lifestyle"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Ver el menú",
      "url": "./index.html",
      "description": "Explorar hamburguesas, pizzas y más"
    },
    {
      "name": "Mi pedido",
      "url": "./index.html",
      "description": "Revisar el carrito de pedido"
    }
  ]
}
